QWidget { background:#121212; color:#e6edf3; font-family:'Segoe UI'; font-size:10pt; }
QFrame#Sidebar { background:#161b22; border-right:1px solid #30363d; }
QPushButton { background:#1e1e1e; border:1px solid #30363d; border-radius:6px; padding:9px 12px; text-align:left; }
QPushButton:hover { background:#263449; border-color:#0d6efd; }
QPushButton:checked { background:#123b68; border-color:#0d6efd; }
QLabel#PageTitle { font-size:20pt; font-weight:600; }
QFrame[card='true'] { background:#1e1e1e; border:1px solid #30363d; border-radius:10px; }
QTableWidget { background:#1e1e1e; alternate-background-color:#242424; gridline-color:#30363d; border:1px solid #30363d; }
QHeaderView::section { background:#161b22; padding:7px; border:0; border-bottom:1px solid #30363d; }
QLineEdit { background:#1e1e1e; border:1px solid #30363d; border-radius:5px; padding:7px; }
